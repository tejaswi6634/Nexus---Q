# Copy this file to ".env" in the same folder and set your values.
# Never commit .env or paste real keys into chat.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
# Deprecated (ignored): live OpenAI is only used when you enter your own prompt(s), not for built-in corpus runs.
OPENAI_LIVE_ALWAYS=

# Anthropic Claude (Messages API) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=1024
# Deprecated (ignored): live Claude only when you enter your own prompt(s).
ANTHROPIC_LIVE_ALWAYS=

# Google AI (Gemini / Generative Language API) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
GOOGLE_MAX_TOKENS=1024
# Deprecated (ignored): live Gemini only when you enter your own prompt(s).
GOOGLE_LIVE_ALWAYS=

# Mistral (OpenAI-compatible API) — https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_MAX_TOKENS=1024
# Optional; default is https://api.mistral.ai/v1
MISTRAL_API_BASE=
